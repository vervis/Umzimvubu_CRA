# ============================================================================
# .gitignore for Umzimvubu_CRA
#
# Rule of thumb: git tracks CODE and small text metadata. DATA and OUTPUTS
# live in Dropbox and are rebuilt by the targets pipeline (_targets.R).
# ============================================================================

# ---- R / RStudio -----------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.Renviron
.httr-oauth
Rplots.pdf

# knitr / R Markdown / Quarto caches and temp files
*_cache/
/cache/
*.utf8.md
*.knit.md
/.quarto/

# ---- Pipeline and package-library state ------------------------------------
# {targets} data store: large and machine-specific, and rebuilt by tar_make()
_targets/
# {renv} package library (renv.lock and renv/activate.R ARE committed)
renv/library/
renv/local/
renv/staging/
renv/sandbox/

# ---- Data: ignore everything under data/ ... -------------------------------
/data/**
# ... but let git look inside the folders (a folder on its own is never
# committed, only the files you re-include below)
!/data/**/
# ... and re-include small text files that record data provenance
!/data/**/manifests/
!/data/**/manifests/*.csv
!/data/**/*_manifest.csv
!/data/**/*_lookup.csv
!/data/**/*.url
!/data/README.md

# ---- Outputs: rebuilt by the pipeline --------------------------------------
/outputs/**
!/outputs/README.md

# ---- Safety net: large binary/geodata files anywhere in the repo -----------
*.tif
*.tiff
*.ovr
*.nc
*.zip
*.gpkg
*.gdb/
*.shp
*.shx
*.dbf
*.sbn
*.sbx
*.dta
*.rds

# ---- Office lock/temp files ------------------------------------------------
~$*
